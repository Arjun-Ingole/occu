{
  "name": "occu-mcp",
  "version": "0.1.0",
  "description": "A macOS-only computer-use MCP server for OpenCode",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "bin": {
    "occu": "dist/src/policy-cli.js",
    "occu-mcp": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "bun run build && bun run test",
    "permissions": "peekaboo permissions",
    "policy": "bun dist/src/policy-cli.js",
    "start": "bun dist/src/cli.js",
    "test": "vitest run --dir test",
    "test:backend": "bun run build && bun scripts/backend-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@steipete/peekaboo": "4.2.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "25.0.10",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
